<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:width="320dp" android:height="180dp">
        <shape android:shape="rectangle">
            <solid android:color="#10181C" />
        </shape>
    </item>
    <!-- Keep the supplied square artwork complete in Fire TV's wide tile. -->
    <item android:width="180dp" android:height="180dp" android:gravity="center">
        <bitmap android:src="@drawable/tv_icon" android:gravity="fill" android:filter="true" />
    </item>
</layer-list>
